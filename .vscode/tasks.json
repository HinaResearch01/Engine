{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build with MSVC",
      "type": "shell",
      "command": "cl.exe",
      "args": [
        "/EHsc",
        "/std:c++20",
        "main.cpp",
        "/Fe:main.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "detail": "Builds C++ source file using MSVC compiler"
    }
  ]
}